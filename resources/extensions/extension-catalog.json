    {
      "id": "agent-local",
      "kind": "app",
      "name": "Agent Local",
      "description": "Runs WordPress sites locally, with databases, TLS and WP-CLI your agents can drive.",
      "keywords": [
        "wordpress",
        "local",
        "sites",
        "database",
        "wp"
      ],
      "version": "0.34.1",
      "platforms": [
        "darwin"
      ],
      "install": {
        "method": "command",
        "command": {
          "update": "agent-local update",
          "binary": "agent-local",
          "versionArgs": [
            "version"
          ],
          "install": "curl -fsSL https://al.tools.efront.dev/install.sh | bash -s -- --setup",
          "setup": "agent-local setup"
        }
      },
      "latest": {
        "source": "agent-local-daemon"
      },
      "autoUpdate": {
        "supported": true
      },
      "about": "Agent Local replaces LocalWP, MAMP and ddev. A background daemon runs PHP, MySQL and a local HTTPS proxy, so a site is a folder plus a hostname with a trusted certificate rather than a container stack to babysit. Import a site from a live host, snapshot and restore the database, switch PHP versions, read the mail it would have sent, and run WP-CLI against it. Every one of those is also an MCP tool, so a coding agent can do the same work without a person clicking through a GUI.",
      "homepage": "https://al.tools.efront.dev/"
    },
    {
      "id": "context7-mcp",
      "kind": "mcp",
      "name": "Context7",
      "description": "Current documentation for any library, pulled into your agent's context on demand.",
      "about": "Ask for a library and Context7 fetches that version\u2019s real documentation and code examples instead of letting the model recall an API that may have changed. Two tools: one resolves a library name to an id, the other returns docs for it. Add the line \"Always use Context7 when I need library or API documentation\" to your agent\u2019s rules and it will reach for this on its own.",
      "keywords": [
        "docs",
        "documentation",
        "library",
        "api",
        "context7",
        "mcp"
      ],
      "version": "4.1.1",
      "install": {
        "method": "config-write",
        "provision": {
          "install": "npm install -g @upstash/context7-mcp",
          "update": "npm install -g @upstash/context7-mcp@latest",
