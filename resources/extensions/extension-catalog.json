    {
      "id": "activecollab-mcp",
      "kind": "mcp",
      "name": "ActiveCollab MCP",
      "description": "Task, comment, attachment and time-tracking tools for your coding agents.",
      "keywords": [
        "activecollab",
        "tasks",
        "tickets",
        "time",
        "mcp"
      ],
      "version": "0.0.0",
      "install": {
        "method": "config-write",
        "provision": {
          "install": "pipx install activecollab-mcp",
          "update": "pipx upgrade activecollab-mcp",
          "binary": "activecollab-mcp",
          "versionArgs": [
            "--version"
          ],
          "uninstall": "pipx uninstall activecollab-mcp"
        },
        "server": {
          "key": "activecollab",
          "harnesses": [
            {
              "id": "claude-code",
              "transport": {
                "kind": "stdio",
                "binary": "activecollab-mcp",
                "args": [
                  "--stdio"
                ],
                "env": {}
              }
            },
            {
              "id": "codex",
              "transport": {
                "kind": "stdio",
                "binary": "activecollab-mcp",
                "args": [
                  "--stdio"
                ],
                "env": {}
              }
            },
            {
              "id": "cursor",
              "transport": {
                "kind": "http",
                "url": "http://127.0.0.1:8787/mcp"
              }
            },
            {
              "id": "grok",
              "transport": {
                "kind": "stdio",
                "binary": "activecollab-mcp",
                "args": [
                  "--stdio"
                ],
                "env": {}
              }
            },
            {
              "id": "omp",
              "transport": {
                "kind": "stdio",
                "binary": "activecollab-mcp",
                "args": [
                  "--stdio"
                ],
                "env": {}
              }
            },
            {
              "id": "pi",
              "transport": {
                "kind": "stdio",
                "binary": "activecollab-mcp",
                "args": [
                  "--stdio"
                ],
                "env": {}
              }
            }
          ]
        }
      },
      "latest": {
        "source": "pypi",
        "package": "activecollab-mcp"
      },
      "autoUpdate": {
        "supported": true
      }
    },
